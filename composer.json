{
    "name": "ksfraser/ksf-fa-org-chart",
    "description": "KSF FrontAccounting Organization Chart Module - FA adapter over ksfraser/ksf-org-chart",
    "type": "library",
    "license": "proprietary",
    "version": "1.0.0",
    "require": {
        "php": ">=7.3",
        "ksfraser/ksf-fa-common": "^1.0",
        "ksfraser/ksf-org-chart": "^1.0",
        "ksfraser/exceptions": "^1.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "ksfraser/famock": "*"
    },
    "autoload": {
        "psr-4": {
            "ksfraser\\FrontAccounting\\OrgChart\\": "src/Ksfraser/FrontAccounting/OrgChart/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Unit\\": "tests/Unit/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml"
    },
    "minimum-stability": "stable",
    "repositories": [
        {
            "type": "path",
            "url": "../ksf_org_chart"
        }
    ],
    "config": {
        "platform": {
            "php": "7.4.33"
        }
    }
}
